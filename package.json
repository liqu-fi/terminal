{
  "name": "reference-perp-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:live": "playwright test --config e2e/tier2/playwright.live.config.ts"
  },
  "dependencies": {
    "@liq/api-client": "npm:@liqcx/liq-api-client@^0.27.2",
    "@liq/core": "npm:@liqcx/liq-core@^0.27.2",
    "@liq/onchain": "npm:@liqcx/liq-onchain@^0.27.2",
    "@liq/prices": "npm:@liqcx/liq-prices@^0.27.2",
    "@liq/react": "npm:@liqcx/liq-react@^0.27.2",
    "@liq/sdk": "npm:@liqcx/liq-sdk@^0.27.2",
    "@liq/subgraph": "npm:@liqcx/liq-subgraph@^0.27.2",
    "@liq/turnkey": "npm:@liqcx/liq-turnkey@^0.27.2",
    "@tanstack/react-query": "^5.100.14",
    "lightweight-charts": "^5.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "viem": "^2.52.0",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@11.1.2"
}
