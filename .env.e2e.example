# Tier 2 (live) e2e configuration. Copy to `.env.e2e.local` (gitignored) and
# fill in, then export the vars (e.g. `set -a; . ./.env.e2e.local; set +a`)
# before running `pnpm test:e2e:live`. Without these, live specs skip.

# Turn the live tier on.
E2E_LIVE=1

# Real order-gateway base URL — INCLUDE the /v1 API version path.
E2E_GATEWAY_URL=https://your-gateway.example.com/v1

# Real RPC for MegaETH testnet.
E2E_RPC_URL=https://carrot.megaeth.com/rpc

# Contract set (staging|production) + chain id.
E2E_DEPLOY_ENV=staging
E2E_CHAIN_ID=6343

# BIP-39 mnemonic for the test wallet. MUST hold testnet ETH (gas) and sUSDC
# (margin) — fund it via the faucet first. NEVER use a mnemonic with real funds.
E2E_MNEMONIC="test test test test test test test test test test test junk"

# How many derivation indices are available (live runs serially; index 0 is used).
E2E_ACCOUNT_COUNT=4

# Upper bound for on-chain settlement / fills on staging (ms).
E2E_FILL_TIMEOUT_MS=180000

# Opt-in: run the live Turnkey (enclave) session-key spec. Tier 1 already covers
# 1-click end-to-end with the wallet-signed session manager, so this is only for
# verifying the enclave path itself. All three must be set or the spec skips.
E2E_TURNKEY_SESSION=0
E2E_TURNKEY_ORG_ID=
E2E_TURNKEY_AUTH_PROXY_CONFIG_ID=
# Optional override (defaults to Turnkey's hosted proxy):
# E2E_TURNKEY_AUTH_PROXY_URL=https://authproxy.turnkey.com

# Opt-in: also run the cold-onboarding live spec. Each run derives a fresh
# wallet, funds its gas with a small ETH transfer from index 0, and MINTS A
# NEW SNX ACCOUNT NFT on staging — run deliberately, not by default.
E2E_LIVE_ONBOARDING=0
