# Backend the reference points at. Both prod and staging are chainId 6343;
# DEPLOY_ENV is what actually selects the contract set.
VITE_DEPLOY_ENV=staging
VITE_CHAIN_ID=6343
# Public order-gateway base URL — INCLUDE the API version path (e.g. .../v1): the SDK
# appends bare routes like /markets and /sse, so the version prefix must live in this URL.
# No trailing slash. The gateway must allow CORS from this SPA's origin.
VITE_GATEWAY_URL=https://your-gateway.example.com/v1
VITE_RPC_URL=https://carrot.megaeth.com/rpc
# Optional. NOT a wagmi connector — wagmi is injected-only; this switches on
# WalletConnect inside Turnkey (wallet-auth as a session-key login method, plus
# wallet connecting). Leave blank and Turnkey still logs in via email OTP,
# passkey or Google. Only meaningful together with VITE_TURNKEY_SESSION below.
VITE_WALLETCONNECT_PROJECT_ID=

# Session keys (1-click trading via Turnkey). Default OFF — when unset/false,
# every order is signed by a wallet popup (unchanged). Set the org-id +
# auth-proxy-config-id from the Turnkey dashboard (Wallet Kit section) to enable.
# VITE_TURNKEY_SESSION=true
# VITE_TURNKEY_ORG_ID=
# VITE_TURNKEY_AUTH_PROXY_CONFIG_ID=
# Optional override (defaults to Turnkey's hosted proxy):
# VITE_TURNKEY_AUTH_PROXY_URL=https://authproxy.turnkey.com
