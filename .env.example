# TBT Paper Terminal Environment Configuration
# Copy this file to .env and customize as needed

# ============================================
# API Configuration (for future use)
# ============================================
# The app uses /binance-api proxy for API calls
# Configure your deployment platform to proxy this path to https://api.binance.com

# Example: If using a custom API endpoint
# VITE_API_BASE_URL=https://your-api-proxy.com

# ============================================
# Feature Flags
# ============================================
# Enable/disable analytics tracking (default: false)
VITE_ENABLE_ANALYTICS=false

# Enable/disable error reporting service (default: false)
VITE_ENABLE_SENTRY=false

# ============================================
# Development Settings
# ============================================
# Enable verbose logging in development
VITE_DEBUG=false

# ============================================
# Deployment Notes
# ============================================
# 1. For Vercel deployment: vercel.json is already configured
# 2. For Nginx deployment: Add proxy_pass for /binance-api to https://api.binance.com
# 3. WebSocket connections go directly to wss://stream.binance.com:9443
