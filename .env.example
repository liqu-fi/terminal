# Backend the reference points at. Both prod and staging are chainId 6343;
# DEPLOY_ENV is what actually selects the contract set.
VITE_DEPLOY_ENV=staging
VITE_CHAIN_ID=6343
# Public order-gateway origin (no trailing slash). Must allow CORS from this SPA's origin.
VITE_GATEWAY_URL=https://staging-gateway.hype.cheap
VITE_RPC_URL=https://carrot.megaeth.com/rpc
# Optional: enables the WalletConnect connector (injected works without it)
VITE_WALLETCONNECT_PROJECT_ID=
